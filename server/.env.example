# Domain, unter der der Server erreichbar ist (muss per DNS auf diesen Server zeigen)
NWW_DOMAIN=reise.example.de

# Geheimer Schlüssel deiner Reisegruppe – mindestens 16 Zeichen, am besten in der App unter
# Einstellungen → Geräte-Abgleich → „Schlüssel erzeugen“ erstellen.
# Mehrere Gruppen: durch Komma trennen (jede Gruppe sieht nur ihre eigenen Daten).
NWW_KEYS=

# Erlaubte Herkunft der App (für mehr Sicherheit statt *):
NWW_ORIGINS=https://mrcatwiesel.github.io

# Maximale Fotogröße in MB
NWW_MAX_BLOB_MB=30

# Optional: Piwigo-Fotogalerie anbinden (ab Piwigo 16.1)
# Adresse im Heimnetz, z. B. http://192.168.5.40 (oder mit Unterordner http://192.168.5.40/piwigo)
NWW_PIWIGO_URL=
# Piwigo → Profil → API-Schlüssel: ID (pkid-…) und Geheimnis; Benutzer muss Administrator sein (für Hochladen)
NWW_PIWIGO_KEY_ID=
NWW_PIWIGO_SECRET=
# Öffentliche Adresse für Links in der App, z. B. https://fotos.example.de
NWW_PIWIGO_PUBLIC_URL=

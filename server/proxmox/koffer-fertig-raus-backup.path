# Sicherung oder Test auf Wunsch aus der App: die App legt die Datei „jetzt“ an, systemd startet backup.sh
[Unit]
Description=KofferFertigRaus – Sicherung auf Anforderung

[Path]
PathExists=/var/lib/koffer-fertig-raus/sicherung/jetzt
Unit=koffer-fertig-raus-backup.service

[Install]
WantedBy=multi-user.target

# systemd-Dienst für den Abgleich-Server (ohne Docker)
# Ablage: /etc/systemd/system/koffer-fertig-raus-sync.service
# Einstellungen: /etc/koffer-fertig-raus/sync.env
[Unit]
Description=KofferFertigRaus – Abgleich-Server
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/koffer-fertig-raus/sync.env
Environment=NWW_DATA=/var/lib/koffer-fertig-raus
WorkingDirectory=/opt/koffer-fertig-raus/server
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=5

# Eigener, unprivilegierter Benutzer; Daten in /var/lib/koffer-fertig-raus
DynamicUser=yes
StateDirectory=koffer-fertig-raus
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target

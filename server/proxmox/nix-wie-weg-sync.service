# systemd-Dienst für den Abgleich-Server (ohne Docker)
# Ablage: /etc/systemd/system/nix-wie-weg-sync.service
# Einstellungen: /etc/nix-wie-weg/sync.env
[Unit]
Description=KofferFertigRaus – Abgleich-Server
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/nix-wie-weg/sync.env
Environment=NWW_DATA=/var/lib/nix-wie-weg
WorkingDirectory=/opt/nix-wie-weg/server
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=5

# Eigener, unprivilegierter Benutzer; Daten in /var/lib/nix-wie-weg
DynamicUser=yes
StateDirectory=nix-wie-weg
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
